# BreadFree 环境变量示例
# 复制为 .env 并填入真实值，不要将 .env 提交到 git

# ── LLM（仅配置 .env 即可，改此处全局生效）──
# LLM_PROVIDER=nvidia
# LLM_PROVIDER=volcano
# 首 token 超过该秒数则退阶下一模型（默认 60）
# LLM_FIRST_TOKEN_TIMEOUT_SECONDS=60

# ── 火山方舟 (Volcano Ark) ──
# ARK_API_KEY=your_ark_api_key
# 多模型逗号分隔，首 token 超时则依次退阶
# ARK_MODEL=ep-xxxxxxxx
# ARK_MODEL=ep-xxx1,ep-xxx2,ep-xxx3
# 可选：分角色模型（不设则用 ARK_MODEL）
# ARK_MODEL_ANALYST=ep-xxx
# ARK_MODEL_RISK=ep-xxx
# ARK_MODEL_FUND=ep-xxx

# ── NVIDIA NIM ──
# NVIDIA_API_KEY=your_nvidia_api_key
# 多模型逗号分隔，首 token 超时则依次退阶
# NVIDIA_MODEL=moonshotai/kimi-k2-instruct-0905
# NVIDIA_MODEL=model1,model2,model3
# 可选：分角色模型（不设则用 NVIDIA_MODEL）
# NVIDIA_MODEL_ANALYST=
# NVIDIA_MODEL_RISK=
# NVIDIA_MODEL_FUND=

# ── 邮件报告 (定时发送) ──
# QQ 邮箱 SMTP (需在 QQ 邮箱设置中开启 SMTP 并获取授权码)
# SMTP_USER=your_email@qq.com
# SMTP_PASSWORD=your_authorization_code
# 收件人 (逗号分隔)
# REPORT_RECIPIENTS=recipient1@qq.com,recipient2@qq.com
